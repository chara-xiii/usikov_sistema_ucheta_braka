<Window x:Class="WpfAppUP3.menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppUP3"
        mc:Ignorable="d"
        Title="ИС «Закупка товара» — Главное меню"
        Height="700" Width="1120"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCream}"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Боковое меню ============ -->
        <Border Grid.Column="0" Background="{StaticResource Espresso}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Border Grid.Row="0" Background="#2E211A" Padding="18,20">
                    <StackPanel>
                        <TextBlock Text="ИС «Закупка товара»" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="учёт брака и прогноз закупок" FontSize="11"
                                   Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Навигация (заполняется по роли) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlNav" Margin="12,14,12,14"/>
                </ScrollViewer>

                <!-- Пользователь -->
                <Border Grid.Row="2" Background="#2E211A" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="lblFio" Text="Пользователь" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="lblRole" Text="Роль" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,2,0,10"/>
                        <Button Content="Выйти" Style="{StaticResource SecondaryButton}" Height="32"
                                Click="Logout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Рабочая область ============ -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="lblTitle" Text="Панель управления" Style="{StaticResource WindowHeader}"/>
                <TextBlock x:Name="lblSubtitle" Text="Сводные показатели по учёту брака"
                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Карточки показателей -->
            <WrapPanel x:Name="pnlKpi" Grid.Row="1" Margin="0,0,0,18"/>

            <!-- Таблица и диаграмма -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Динамика выявленного брака по месяцам"
                                   Style="{StaticResource PanelHeader}" Margin="0,0,0,12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnlChart"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Последние зарегистрированные дефекты"
                                   Style="{StaticResource PanelHeader}" Margin="0,0,0,12"/>
                        <DataGrid x:Name="dgRecent" Style="{StaticResource AppDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Data}" Width="90"/>
                                <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="Поставщик" Binding="{Binding Postavshchik}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Kolichestvo}" Width="80"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>