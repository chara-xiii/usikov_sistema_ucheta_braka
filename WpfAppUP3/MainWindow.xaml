<Window x:Class="WpfAppUP3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppUP3"
        mc:Ignorable="d"
        Title="Учёт брака — Авторизация"
        Height="619" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCream}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="30">
        <Border Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,26">
            <Border.Effect>
                <DropShadowEffect Color="#3A2A21" Opacity="0.12" BlurRadius="18" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Шапка -->
                <Border Background="{StaticResource Espresso}" CornerRadius="8" Padding="16,14" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="ИС «Закупка товара»"
                                   FontSize="19" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Учёт брака и прогнозирование закупок качественного товара"
                                   FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Авторизация" Style="{StaticResource WindowHeader}" Margin="0,0,0,16"/>

                <!-- Логин -->
                <TextBlock Text="Логин" Style="{StaticResource BaseText}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLogin" Style="{StaticResource FieldTextBox}" Height="34"
                         Text="admin" Margin="0,0,0,12"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Style="{StaticResource BaseText}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource FieldPasswordBox}" Height="34"
                             Password="admin" Margin="0,0,0,12"/>

                <!-- Сервер -->
                <TextBlock Text="Сервер" Style="{StaticResource BaseText}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtServer" Style="{StaticResource FieldTextBox}" Height="34"
                             Text="YOUR_SQL_SERVER" Margin="0,0,0,12"/>

                <!-- База данных -->
                <TextBlock Text="База данных" Style="{StaticResource BaseText}" Margin="0,0,0,5"/>
                <TextBox x:Name="txtBd" Style="{StaticResource FieldTextBox}" Height="34"
                         Text="YOUR_DATABASE" Margin="0,0,0,18"/>

                <Button x:Name="BtnAutorization" Content="Войти" Height="40"
                        Style="{StaticResource PrimaryButton}" Click="BtnAutorization_Click"/>

                <TextBlock Text="Тестовые учётные записи: admin/admin · manager/manager · proizvod/proizvod"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
