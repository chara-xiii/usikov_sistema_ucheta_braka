<Window x:Class="WpfAppUP3.postavshchiki"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppUP3"
        mc:Ignorable="d"
        Title="Справочник поставщиков"
        Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCream}"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Справочник поставщиков" Style="{StaticResource WindowHeader}"/>
            <TextBlock Text="Ведение списка контрагентов и их реквизитов"
                       Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dg" Grid.Row="1" Style="{StaticResource AppDataGrid}"
                  SelectionChanged="dg_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id_postavshchika}" Width="50"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="120"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Telefon}" Width="150"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Adres}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Договор" Binding="{Binding Data_dogovora}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="230" Margin="0,0,14,10">
                        <TextBlock Text="Наименование" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtName" Style="{StaticResource FieldTextBox}" Height="32"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,14,10">
                        <TextBlock Text="ИНН" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtINN" Style="{StaticResource FieldTextBox}" Height="32"/>
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,14,10">
                        <TextBlock Text="Телефон" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTel" Style="{StaticResource FieldTextBox}" Height="32"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,14,10">
                        <TextBlock Text="E-mail" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource FieldTextBox}" Height="32"/>
                    </StackPanel>
                    <StackPanel Width="300" Margin="0,0,14,10">
                        <TextBlock Text="Адрес" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAdres" Style="{StaticResource FieldTextBox}" Height="32"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,14,10">
                        <TextBlock Text="Дата договора" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpData" Style="{StaticResource FieldDatePicker}" Height="32"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Width="130" Margin="0,0,10,0" Click="add_Click"/>
                    <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Width="130" Margin="0,0,10,0" Click="upd_Click"/>
                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Width="130" Margin="0,0,10,0" Click="del_Click"/>
                    <Button Content="Очистить" Style="{StaticResource SecondaryButton}" Width="130" Click="clear_Click"/>
                    <TextBox x:Name="txtID" Width="60" Margin="14,0,0,0" Visibility="Hidden"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>