<Window x:Class="WpfAppUP3.prognoz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppUP3"
        mc:Ignorable="d"
        Title="Прогнозирование закупок"
        Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCream}"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Прогнозирование закупок качественного товара" Style="{StaticResource WindowHeader}"/>
            <TextBlock Text="Расчёт вероятности брака по поставщикам и линия тренда доли брака"
                       Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Параметры анализа" Style="{StaticResource PanelHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="Материал" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbMaterial" Style="{StaticResource FieldComboBox}" Height="32" Margin="0,0,0,10"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <TextBlock Text="Поставщик" Style="{StaticResource BaseText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbPostavshchik" Style="{StaticResource FieldComboBox}" Height="32" Margin="0,0,0,10"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <Button Content="Рассчитать прогноз" Style="{StaticResource PrimaryButton}" Height="36" Click="btnCalc_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource LightPistachio}" BorderBrush="{StaticResource AccentDark}"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Рекомендация по закупке" Style="{StaticResource PanelHeader}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="lblRecomend" Text="Нажмите «Рассчитать прогноз»."
                                   Style="{StaticResource BaseText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Вероятность брака по поставщикам"
                                   Style="{StaticResource PanelHeader}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dg" Style="{StaticResource AppDataGrid}" MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Поставщик" Binding="{Binding Postavshchik}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Поставлено" Binding="{Binding Postavleno}" Width="100"/>
                                <DataGridTextColumn Header="Брак" Binding="{Binding Brak}" Width="80"/>
                                <DataGridTextColumn Header="Вероятность" Binding="{Binding Veroyatnost}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- График -->
            <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Линия тренда доли брака по месяцам, %"
                               Style="{StaticResource PanelHeader}" Margin="0,0,0,10"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="chartCanvas" Width="640" Height="380" Background="Transparent"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
